# Required
DISCORD_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE
CLIENT_ID=PASTE_YOUR_APPLICATION_ID_HERE

# Optional but recommended while developing.
# If set, commands are registered to this guild immediately.
GUILD_ID=PASTE_YOUR_SERVER_ID_HERE

# Optional: ID of a channel where command/moderation logs are sent.
LOG_CHANNEL_ID=

# Optional: ID of the category where ticket channels should be created.
TICKET_CATEGORY_ID=

# Optional: ID of the role allowed to manage tickets.
TICKET_STAFF_ROLE_ID=

# Optional: ID of the role allowed to use administrative bot commands.
# If blank, Discord permissions are used.
BOT_ADMIN_ROLE_ID=

# Prefix is only used in a few configuration messages; the bot itself uses slash commands.
BOT_NAME=ProGuard
